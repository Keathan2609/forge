# ---------------------------------------------------------------------------
# FORGE — example environment. Copy to .env and adjust.
# Never commit a populated .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
FORGE_LOG_LEVEL=info

# --- Datastores -------------------------------------------------------------
# PostgreSQL is the durable source of truth for all execution state.
DATABASE_URL=postgresql://forge:forge@localhost:5435/forge?schema=public
# Redis is transport only (queues + pub/sub fan-out). Never the source of truth.
REDIS_URL=redis://localhost:6381

# --- API --------------------------------------------------------------------
FORGE_API_PORT=4000
FORGE_API_HOST=0.0.0.0
FORGE_CORS_ORIGIN=http://localhost:3000
# Lightweight development auth. Requests must send `x-forge-api-key`.
# Set FORGE_AUTH_ENABLED=false to disable entirely for local exploration.
FORGE_AUTH_ENABLED=true
FORGE_API_KEY=dev-local-key
FORGE_RATE_LIMIT_WINDOW_MS=60000
FORGE_RATE_LIMIT_MAX=600

# --- Worker -----------------------------------------------------------------
# Comma separated queues this worker consumes.
FORGE_WORKER_QUEUES=default
# Comma separated handler types this worker advertises.
FORGE_WORKER_CAPABILITIES=noop,delay,compute,http.echo,transform,validate,simulate.flaky,simulate.fail,simulate.timeout,simulate.crash,simulate.slow
FORGE_WORKER_CONCURRENCY=4
FORGE_WORKER_HEARTBEAT_MS=2000
FORGE_WORKER_LEASE_TTL_MS=15000
FORGE_WORKER_METRICS_PORT=9101

# --- Scheduler / control plane ---------------------------------------------
FORGE_SCHEDULER_METRICS_PORT=9102
FORGE_OUTBOX_POLL_MS=250
FORGE_OUTBOX_BATCH=200
FORGE_REAPER_POLL_MS=2000
FORGE_RETRY_POLL_MS=500
FORGE_SCHEDULE_POLL_MS=1000

# --- Demo / failure injection ----------------------------------------------
# Enables the simulate.* task handlers and the failure-injection API.
# MUST remain false outside local/demo environments.
FORGE_DEMO_MODE=true

# --- Observability ----------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=forge

# --- Web console ------------------------------------------------------------
NEXT_PUBLIC_FORGE_API_URL=http://localhost:4000
FORGE_WEB_PORT=3000
# Server-side key used by the Next.js proxy route when auth is enabled.
FORGE_API_KEY_WEB=dev-local-key
