{
  "name": "@forge/web",
  "version": "0.1.0",
  "private": true,
  "description": "FORGE console — mission-control UI for workflow authoring, live execution, the worker fleet and dead letters.",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3000",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --dir test",
    "test:e2e": "playwright test",
    "clean": "rimraf .next dist .turbo"
  },
  "dependencies": {
    "@forge/contracts": "workspace:*",
    "@forge/sdk": "workspace:*",
    "@xyflow/react": "^12.4.2",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
