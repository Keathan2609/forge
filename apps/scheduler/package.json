{
  "name": "@forge/scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "FORGE control plane: outbox publisher, run advancer, lease reaper, retry sweeper and cron scheduler.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration --testTimeout=90000",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@forge/config": "workspace:*",
    "@forge/contracts": "workspace:*",
    "@forge/database": "workspace:*",
    "@forge/engine": "workspace:*",
    "@forge/logger": "workspace:*",
    "@forge/observability": "workspace:*",
    "cron-parser": "^4.9.0",
    "zod": "^3.24.1",
    "@forge/transport": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "@forge/testing": "workspace:*"
  }
}
