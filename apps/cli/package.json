{
  "name": "@forge/cli",
  "version": "0.1.0",
  "description": "forge — command line interface for the FORGE orchestration engine.",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "forge": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/bin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@forge/contracts": "workspace:*",
    "@forge/sdk": "workspace:*",
    "commander": "^13.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
