{
  "name": "@forge/api",
  "version": "0.1.0",
  "private": true,
  "description": "FORGE control API. Owns workflow definitions, run lifecycle commands and the real-time event stream. Never executes tasks.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --dir test/unit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@forge/config": "workspace:*",
    "@forge/contracts": "workspace:*",
    "@forge/database": "workspace:*",
    "@forge/engine": "workspace:*",
    "@forge/logger": "workspace:*",
    "@forge/observability": "workspace:*",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@nestjs/platform-express": "^11.0.5",
    "@nestjs/terminus": "^11.0.0",
    "cron-parser": "^4.9.0",
    "express": "^4.21.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.6",
    "@forge/transport": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.5",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "@swc/core": "^1.10.9",
    "vitest": "^2.1.8"
  }
}
