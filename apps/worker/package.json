{
  "name": "@forge/worker",
  "version": "0.1.0",
  "private": true,
  "description": "FORGE task worker. Leases tasks, executes registered handlers under timeout and cancellation, renews leases and reports outcomes.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration --testTimeout=90000",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@forge/config": "workspace:*",
    "@forge/contracts": "workspace:*",
    "@forge/database": "workspace:*",
    "@forge/engine": "workspace:*",
    "@forge/logger": "workspace:*",
    "@forge/observability": "workspace:*",
    "zod": "^4.6.6",
    "@forge/transport": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
