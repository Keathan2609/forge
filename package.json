{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "FORGE — a self-hosted distributed workflow orchestration engine with durable execution, worker leasing and a transactional outbox.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "pnpm --filter @forge/web test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @forge/database generate",
    "db:migrate": "pnpm --filter @forge/database migrate",
    "db:deploy": "pnpm --filter @forge/database deploy",
    "db:push": "pnpm --filter @forge/database push",
    "db:reset": "pnpm --filter @forge/database reset",
    "db:studio": "pnpm --filter @forge/database studio",
    "demo:seed": "pnpm --filter @forge/database seed",
    "demo:run": "node scripts/with-env.mjs tsx scripts/demo-run.ts",
    "demo:chaos": "node scripts/with-env.mjs tsx scripts/chaos-demo.ts",
    "forge:infra": "docker compose -f infra/docker/docker-compose.yml up -d postgres redis jaeger prometheus",
    "forge:dev": "node scripts/dev.mjs",
    "forge:up": "docker compose -f infra/docker/docker-compose.yml up -d --build",
    "forge:down": "docker compose -f infra/docker/docker-compose.yml down",
    "forge:nuke": "docker compose -f infra/docker/docker-compose.yml down -v",
    "forge:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "clean": "turbo run clean",
    "test:setup": "node scripts/test-env.mjs",
    "test:setup:reset": "node scripts/test-env.mjs --reset",
    "examples:export": "node scripts/with-env.mjs tsx scripts/export-examples.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8",
    "@forge/sdk": "workspace:*",
    "@forge/database": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@swc/core",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  }
}
